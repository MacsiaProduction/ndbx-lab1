        {
          "name": "Создать отзыв",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Cookie",
                "value": "X-Session-Id={{session_id}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/events/{{event_id}}/reviews",
            "description": "POST /events/{event_id}/reviews — `comment` (≤300), `rating` 1–5.",
            "body": {
              "mode": "raw",
              "raw": "{\"comment\": \"Великолепный спектакль!\", \"rating\": 5}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const setCookie = pm.response.headers.get('Set-Cookie');",
                  "if (setCookie) {",
                  "    const match = setCookie.match(/X-Session-Id=([^;]+)/);",
                  "    if (match) pm.environment.set('session_id', match[1]);",
                  "}"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    if (json.id) pm.environment.set('review_id', json.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": [
