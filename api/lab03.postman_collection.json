          "name": "Регистрация пользователя",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Cookie",
                "value": "X-Session-Id={{session_id}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/users",
            "description": "POST /users — `full_name`, `username`, `password`. При успехе **201**, новая сессия в cookie.",
            "body": {
              "mode": "raw",
              "raw": "{\"full_name\": \"Иван Иванов\", \"username\": \"ivan_demo\", \"password\": \"strong_password_123\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const setCookie = pm.response.headers.get('Set-Cookie');",
                  "if (setCookie) {",
                  "    const match = setCookie.match(/X-Session-Id=([^;]+)/);",
                  "    if (match) pm.environment.set('session_id', match[1]);",
