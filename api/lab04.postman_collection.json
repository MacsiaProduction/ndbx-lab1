              ]
            },
            "description": "GET /users — `name` (substring), `id`, `limit`, `offset`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    if (json.users && json.users.length > 0) {",
                  "        pm.environment.set('user_id', json.users[0].id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
